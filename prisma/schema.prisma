// prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
  // "native" covers local development. The musl target is required by the
  // on-prem Docker image (node:20-alpine, OpenSSL 3.x) — without it Prisma
  // tries to download an engine at container start and fails on a read-only,
  // non-root filesystem.
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Enums ----------
enum Role {
  ADMIN
  CIO
  PMO
  VERTICAL_HEAD
  BUSINESS
  PROGRAM_HEAD
  PROGRAM_MANAGER
  BUSINESS_HEAD
}

enum InitiativeType {
  CHANGE_REQUEST
  PROJECT
}

// Leadership importance, independent of delivery type (InitiativeType) and
// regulatory criticality (isRegulatory) — a regulatory initiative can be
// Strategic, Major Project, Tactical, or BAU.
enum InitiativeClassification {
  STRATEGIC
  MAJOR_PROJECT
  TACTICAL
  BAU
}

enum Methodology {
  WATERFALL
  AGILE
}

// The delivery lifecycle is NO LONGER an enum. It lives in LifecycleStage,
// one row per stage per organization, so a mid-market SME can run six stages
// and a regulated bank eleven without a schema change or a deploy.
//
// See docs/ROADMAP.md R1: converting this was trivial with seed data and
// painful once clients hold live history, which is why it happened in M4.

// Where a stage sits relative to the thing actually being delivered. This is
// the semantic the engine keys off — never the stage's name. "Has it shipped
// yet?" is a question about DeliveryPhase, not about whether a stage is
// spelled "UAT".
enum DeliveryPhase {
  PRE_DELIVERY // shaping, specifying, funding — nothing exists yet
  IN_DELIVERY // building, testing, approving — exists but is not live
  POST_DELIVERY // live; the promised value is now observable
}

enum ProcessGroup {
  INITIATING
  PLANNING
  EXECUTING
  MONITORING_CONTROLLING
  CLOSING
}

enum BenefitCategory {
  REVENUE
  COST_SAVING
  CUSTOMER_EXPERIENCE
  COMPLIANCE
  EFFICIENCY
  RISK_REDUCTION
}

// Why an investment is funded — which determines what justifies it.
// DELIBERATELY SEPARATE from `isRegulatory`: that flag drives deadline
// tracking and Regulatory Watch, this drives funding logic. An initiative can
// be both (RBI-mandated AND revenue-generating); the category records what the
// funding decision actually rests on.
//
// Only VALUE_GENERATING is gated on ROI. Gating the others would block the one
// category that is legally non-negotiable (regulatory) and starve the work that
// enables everything else (foundational) — see docs/ROADMAP.md §3.
enum InvestmentCategory {
  VALUE_GENERATING // justified by return — ROI gate applies
  REGULATORY_MANDATORY // justified by a mandate; ROI is irrelevant
  FOUNDATIONAL // enables other initiatives; returns indirectly
  STRATEGIC // defensive or positioning; return is unmeasurable
}

enum DelaySource {
  IT
  BUSINESS
  VENDOR
  EXTERNAL
}

enum KnowledgeAreaName {
  INTEGRATION
  SCOPE
  SCHEDULE
  COST
  QUALITY
  RESOURCE
  COMMUNICATIONS
  RISK
  PROCUREMENT
  STAKEHOLDER
}

enum KAStatus {
  GREEN
  AMBER
  RED
}

enum OutcomeAchieved {
  YES
  PARTIALLY
  NO
}

enum StoryStatus {
  TODO
  IN_PROGRESS
  REVIEW
  DONE
}

enum MilestoneStatus {
  NOT_STARTED
  IN_PROGRESS
  BLOCKED
  COMPLETED
}

enum MilestoneOwnerRole {
  PMO
  IT
  BUSINESS
  VENDOR
}

// ---------- Value realization ----------
enum BenefitUnit {
  INR
  PERCENT
  DAYS
  HOURS
  COUNT
  RATIO
}

enum Confidence {
  HIGH
  MEDIUM
  LOW
}

enum DemandStatus {
  RAISED
  UNDER_REVIEW
  APPROVED
  REJECTED
  ON_HOLD
}

enum DemandPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

// ---------- Workspace / Organisation ----------
model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  industry  String?
  status    String   @default("PILOT")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Minimum ROI a VALUE_GENERATING initiative must clear before it needs an
  // approved exception. Deliberately nullable with NO default: required return
  // varies enormously by sector and cost of capital, so shipping a universal
  // "1.5x" would be a fabricated number of exactly the kind M0 removed.
  // null = no threshold configured = the gate is inactive.
  roiThreshold Float?

  // ₹ above which a value sign-off or a cost change needs a second approver.
  // Nullable with no default, for the same reason as roiThreshold: what counts
  // as material varies by organization. null = maker-checker inactive.
  //
  // Tiering matters here. Four-eyes on every ₹20 lakh BAU change gets bypassed
  // within a month, and a bypassed control is worse than no control because it
  // creates false assurance. Apply it where the number is material; let small
  // items move on a single sign-off.
  materialityThresholdInr Float?

  // ---- Configurability (M4) ----

  // Which lifecycle template this workspace was provisioned from. Recorded for
  // support and upgrade purposes only — the stages in LifecycleStage are the
  // truth, and an organization is free to diverge from its template.
  lifecycleTemplate String?

  // Per-organization noun overrides, e.g. {"initiative":"Project"}. A BOUNDED
  // set of keys with shipped defaults — see lib/terminology.ts. Deliberately
  // not free-form: an unbounded dictionary is unmaintainable and would let a
  // client rename something the product's own guidance still refers to.
  terminology Json?

  // Module switches. A lean SME does not carry a regulator, does not model
  // cross-system dependencies, and does not want a milestone tab it never
  // fills in. Turning these off removes the surface rather than showing an
  // empty one, which is the difference between "configurable" and "cluttered".
  moduleRegulatory   Boolean @default(true)
  moduleDependencies Boolean @default(true)
  moduleMilestones   Boolean @default(true)

  users           User[]
  initiatives     Initiative[]
  demands         Demand[]
  okrs            Okr[]
  reports         MonthlyReport[]
  lifecycleStages LifecycleStage[]
}

/// One delivery stage in one organization's lifecycle.
///
/// Deliberately NOT referenced by a database foreign key from Initiative or
/// HistoryLog. The integrity that matters here is "you cannot delete a stage
/// initiatives are sitting in", which is enforced in the server action with a
/// message a human can act on, rather than surfacing as a constraint violation.
/// A raw FK would also make history brittle: a closed initiative's audit trail
/// should survive its organization retiring a stage.
model LifecycleStage {
  id             String       @id @default(cuid())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String

  /// Stable machine key, referenced by Initiative.currentStage and
  /// HistoryLog.stage. Never rendered — renaming what a client calls a stage
  /// must not rewrite history, so the label changes and the key does not.
  key   String
  /// What this organization calls the stage. Safe to edit at any time.
  label String
  /// Position in the lifecycle. Not uniquely constrained: reordering with a
  /// unique index requires temporary values, and a duplicate order is a
  /// configuration mistake, not a corruption.
  order Int

  processGroup  ProcessGroup
  deliveryPhase DeliveryPhase

  /// The stage at which the initiative is live. Realization clocks start here,
  /// and the go-live date on the audit trail is read from it. At most one per
  /// organization.
  isGoLiveGate Boolean @default(false)

  /// Where the business confirms the outcome actually happened. Drives the
  /// validation form and the "awaiting confirmation" queue.
  isValidationGate Boolean @default(false)

  /// Nothing follows. RAG goes quiet, reminders stop, the item is done.
  isTerminal Boolean @default(false)

  @@unique([organizationId, key])
  @@index([organizationId])
}

// ---------- Auth / Users ----------
model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role
  // when role = VERTICAL_HEAD this is their own name key used to scope initiatives
  verticalHead String?

  // ---- Multi-factor authentication (M5) ----
  // Base32 TOTP secret. Present but with mfaEnabledAt null means enrolment was
  // started and never confirmed — that state must NOT enforce a second factor,
  // or a user who closed the tab mid-enrolment locks themselves out.
  mfaSecret        String?
  mfaEnabledAt     DateTime?
  // bcrypt hashes, single-use. Hashed for the same reason passwords are: a
  // database dump must not hand someone a working second factor.
  mfaRecoveryCodes String[]  @default([])
  avatarUrl    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Enterprise role model — which portfolio/reporting line this user belongs
  // to. Directory/reporting metadata: who this user's Program Head, Program
  // Manager, and Business Head are, and their business unit / sub-unit.
  // Nullable — most pilot users won't have these set.
  programHeadName    String?
  programManagerName String?
  businessHeadName   String?
  businessUnit       String?
  subBusinessUnit    String?

  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])

  ownedInitiatives Initiative[] @relation("VerticalHeadInitiatives")
  historyEntries   HistoryLog[]
  raisedDemands    Demand[]     @relation("RaisedDemands")
}

// ---------- Core ----------
model Initiative {
  id             String                   @id @default(cuid())
  title          String
  type           InitiativeType
  classification InitiativeClassification @default(TACTICAL)
  methodology    Methodology              @default(WATERFALL)

  verticalHeadName String
  verticalHead     User?   @relation("VerticalHeadInitiatives", fields: [verticalHeadId], references: [id])
  verticalHeadId   String?
  businessSpoc     String
  businessSponsor  String
  description      String

  // Enterprise role model — assignment fields for manager-level visibility.
  // Nullable: existing initiatives predate these and pilot data may leave
  // them unset. Matched by name against the assignee's session, mirroring
  // how verticalHeadName/businessSpoc already scope VERTICAL_HEAD/BUSINESS.
  programHeadName    String?
  programManagerName String?
  businessHeadName   String?
  businessUnit       String?
  subBusinessUnit    String?

  // business value (intent) — benefitCategory/outcomeDescription/targetMetric
  // are the legacy single-benefit summary; structured value lives in BenefitClaim[].
  benefitCategory    BenefitCategory
  outcomeDescription String
  targetMetric       String
  expectedGoLiveDate DateTime

  // value governance / cost (Value Realization Layer)
  //
  // COST — two capture modes, deliberately tiered so small initiatives aren't
  // strangled by a 5-field form (see docs/ROADMAP.md M1):
  //   Simple   — estimatedCostInr alone: one total-cost-over-horizon number.
  //   Detailed — buildCostInr + annualRunCostInr + tcoHorizonYears, for
  //              material initiatives where the breakdown is checkable.
  // actualCostInr overrides both once real spend is known.
  // Never synthesise any of these: a missing cost is "not captured", and ROI
  // must be suppressed rather than shown against a guessed denominator.
  // Resolve with computeTco() in lib/value.ts — never sum these inline.
  estimatedCostInr Float?
  actualCostInr    Float?
  buildCostInr     Float?
  annualRunCostInr Float?
  tcoHorizonYears  Int?

  valueSignedOff   Boolean   @default(false)
  valueSignOffBy   String?
  valueSignOffAt   DateTime?
  // Frozen at the moment of sign-off so the promise can be compared against the
  // outcome years later. These cannot be reconstructed after the fact — if the
  // claim or cost is edited later, these still hold what was actually committed
  // to. Formal re-baseline/restatement handling is M3.
  signedOffValueInr Float?
  signedOffTcoInr   Float?

  // What justifies funding this. Separate concern from isRegulatory below —
  // see the InvestmentCategory enum comment.
  investmentCategory InvestmentCategory @default(VALUE_GENERATING)

  // regulatory / compliance criticality (e.g. RBI/NPCI-mandated, externally-fixed deadline)
  isRegulatory      Boolean   @default(false)
  regulatoryBody    String?
  regulatoryDueDate DateTime?

  // waterfall current-state (only meaningful when methodology = WATERFALL)
  // The `key` of a LifecycleStage belonging to this initiative's organization.
  // No default: the first stage depends on the organization's lifecycle, so it
  // is resolved at creation rather than assumed to be "BRD".
  currentStage        String
  currentProcessGroup ProcessGroup @default(INITIATING)
  stageStartDate      DateTime
  stageExpectedDate   DateTime
  lastUpdated         DateTime
  notes               String       @default("")
  delayed             Boolean      @default(false)
  delaySource         DelaySource?
  delayReason         String?

  committedMonth String? // "YYYY-MM" for monthly-commitment tracking

  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stages           WaterfallStage[]
  milestones       Milestone[]
  knowledgeAreas   KnowledgeArea[]
  risks            Risk[]
  stakeholders     Stakeholder[]
  valueRealization BusinessValueRealization?
  history          HistoryLog[]
  epics            Epic[]
  sprints          Sprint[]
  stories          Story[]
  benefitClaims    BenefitClaim[]
  okrLinks         InitiativeOkr[]
  originDemand     Demand?                   @relation("DemandInitiative")
  dependsOn        Dependency[]              @relation("Dependent")
  blocking         Dependency[]              @relation("Blocker")
  investmentExceptions InvestmentException[]
  pendingApprovals     PendingApproval[]
  valueRestatements    ValueRestatement[]

  @@index([verticalHeadName])
  @@index([currentStage])
  @@index([type])
  @@index([classification])
  @@index([organizationId, classification])
  @@index([organizationId, isRegulatory])
  @@index([organizationId, businessUnit])
  @@index([organizationId, businessHeadName])
  @@index([organizationId, programHeadName])
  @@index([organizationId, programManagerName])
}

model WaterfallStage {
  id            String       @id @default(cuid())
  initiative    Initiative   @relation(fields: [initiativeId], references: [id], onDelete: Cascade)
  initiativeId  String
  stage         String // LifecycleStage.key
  processGroup  ProcessGroup
  expectedDate  DateTime
  startedDate   DateTime?
  completedDate DateTime?
  daysInStage   Int? // snapshot only; live value computed at render
  delayFlag     Boolean      @default(false)
  delaySource   DelaySource?

  @@unique([initiativeId, stage])
  @@index([initiativeId])
}

// A flat list of named checkpoints per initiative — deliberately lightweight.
// Not a WBS: no parent/child hierarchy, no subtasks, no dependency links
// between milestones (that's Dependency, which is between Initiatives, not
// this), no Gantt/scheduling fields, no resource or effort/hours tracking,
// no sprint/task board linkage, no timesheets. If any of that is ever
// needed, it's a deliberate new model/feature, not an extension of this one.
//
// Typical checkpoints (not enforced — title is free text): BRD Sign-off,
// FSD Sign-off, SIT Completion, UAT Sign-off, AppSec Closure, CAB Approval,
// Go-Live Readiness, Business Validation.
model Milestone {
  id           String     @id @default(cuid())
  initiativeId String
  initiative   Initiative @relation(fields: [initiativeId], references: [id], onDelete: Cascade)

  title       String // checkpoint name, e.g. "UAT Sign-off"
  description String? // optional detail
  owner       String // accountable person/team
  ownerRole   MilestoneOwnerRole? // accountable side: PMO / IT / Business / Vendor
  dueDate     DateTime // planned checkpoint date
  status      MilestoneStatus     @default(NOT_STARTED)

  completedAt DateTime? // actual completion date
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([initiativeId])
  @@index([status])
  @@index([dueDate])
}

// ---------- Governance (delivery health areas) ----------
model KnowledgeArea {
  id           String            @id @default(cuid())
  initiative   Initiative        @relation(fields: [initiativeId], references: [id], onDelete: Cascade)
  initiativeId String
  name         KnowledgeAreaName
  status       KAStatus          @default(GREEN)
  notes        String            @default("")
  updatedAt    DateTime          @updatedAt

  @@unique([initiativeId, name])
}

model Risk {
  id           String     @id @default(cuid())
  initiative   Initiative @relation(fields: [initiativeId], references: [id], onDelete: Cascade)
  initiativeId String
  description  String
  probability  Int // 1..5
  impact       Int // 1..5
  response     String
  owner        String
  createdAt    DateTime   @default(now())

  @@index([initiativeId])
}

model Stakeholder {
  id           String     @id @default(cuid())
  initiative   Initiative @relation(fields: [initiativeId], references: [id], onDelete: Cascade)
  initiativeId String
  name         String
  role         String
  influence    Int // 1..5
  interest     Int // 1..5

  @@index([initiativeId])
}

model BusinessValueRealization {
  id              String          @id @default(cuid())
  initiative      Initiative      @relation(fields: [initiativeId], references: [id], onDelete: Cascade)
  initiativeId    String          @unique
  outcomeAchieved OutcomeAchieved
  actualResult    String
  actualMetric    String
  realizedDate    DateTime?
  updatedAt       DateTime        @updatedAt
}

// ---------- Agile ----------
model Epic {
  id           String     @id @default(cuid())
  initiative   Initiative @relation(fields: [initiativeId], references: [id], onDelete: Cascade)
  initiativeId String
  title        String
  description  String     @default("")
  stories      Story[]

  @@index([initiativeId])
}

model Sprint {
  id           String     @id @default(cuid())
  initiative   Initiative @relation(fields: [initiativeId], references: [id], onDelete: Cascade)
  initiativeId String
  number       Int
  startDate    DateTime
  endDate      DateTime
  capacity     Int // story points
  stories      Story[]

  @@unique([initiativeId, number])
  @@index([initiativeId])
}

model Story {
  id           String      @id @default(cuid())
  initiative   Initiative  @relation(fields: [initiativeId], references: [id], onDelete: Cascade)
  initiativeId String
  epic         Epic?       @relation(fields: [epicId], references: [id])
  epicId       String?
  sprint       Sprint?     @relation(fields: [sprintId], references: [id])
  sprintId     String?
  title        String
  points       Int         @default(0)
  status       StoryStatus @default(TODO)
  createdAt    DateTime    @default(now())

  @@index([initiativeId])
  @@index([sprintId])
}

// ---------- Cross-cutting ----------
model HistoryLog {
  id           String     @id @default(cuid())
  initiative   Initiative @relation(fields: [initiativeId], references: [id], onDelete: Cascade)
  initiativeId String
  stage        String? // LifecycleStage.key; null for non-stage edits
  note         String
  user         User?      @relation(fields: [userId], references: [id])
  userId       String?
  userName     String // denormalized for display stability
  createdAt    DateTime   @default(now())

  @@index([initiativeId])
}

// A VALUE_GENERATING initiative funded below the organization's ROI threshold,
// with the justification and the approver on record.
//
// APPEND-ONLY BY CONVENTION: rows are never updated or deleted. Re-approving
// after the numbers change writes a NEW row, so the sequence of decisions stays
// intact — "we approved this at 0.8x in March and again at 1.1x in July" is
// exactly the governance history a board or auditor asks for.
//
// The gate this backs is deliberately SOFT: below-threshold work is escalated
// for explicit justification, never blocked. Hard thresholds get gamed —
// sponsors inflate benefits until they clear the bar — which would manufacture
// the dishonesty the rest of this product exists to eliminate.
model InvestmentException {
  id           String     @id @default(cuid())
  initiative   Initiative @relation(fields: [initiativeId], references: [id], onDelete: Cascade)
  initiativeId String

  // Frozen at the moment of approval. The live ROI will drift as value and cost
  // are edited; what matters for accountability is what was on the table when
  // somebody signed.
  roiAtApproval       Float
  thresholdAtApproval Float
  valueInrAtApproval  Float
  tcoInrAtApproval    Float

  justification  String // free text — why this is worth funding anyway
  approvedBy     String // denormalised for display stability
  approvedByRole String
  approvedAt     DateTime @default(now())

  @@index([initiativeId])
}

enum PendingApprovalKind {
  VALUE_SIGN_OFF
  COST_CHANGE
}

enum PendingApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

// Maker-checker. A material change is PROPOSED here and does not take effect
// until a DIFFERENT person approves it — segregation of duties, enforced
// server-side by comparing proposedBy against the approver, not by hiding a
// button.
//
// Only changes at or above the organization's materiality threshold come
// through here. Below it, changes apply immediately as before: a control
// applied to everything gets routed around, and a routed-around control is
// worse than none because it manufactures false assurance.
model PendingApproval {
  id           String     @id @default(cuid())
  initiative   Initiative @relation(fields: [initiativeId], references: [id], onDelete: Cascade)
  initiativeId String

  kind    PendingApprovalKind
  // The proposed change, applied verbatim on approval. Shape depends on kind.
  payload Json
  // Human-readable description of what will change, frozen at proposal time so
  // the approver sees exactly what they are agreeing to.
  summary String
  // The ₹ figure that made this material — recorded so a later reader can see
  // why four-eyes was triggered even if the threshold has since moved.
  materialityInr Float

  proposedBy     String
  proposedByRole String
  proposedAt     DateTime @default(now())

  status        PendingApprovalStatus @default(PENDING)
  decidedBy     String?
  decidedByRole String?
  decidedAt     DateTime?
  decisionNote  String?

  @@index([initiativeId])
  @@index([status])
}

// A committed number that changed after sign-off.
//
// Financial reporting does not quietly edit a published figure — it restates,
// visibly. Same rule here: once value is signed off, the claim is locked, and
// altering it requires an explicit restatement recording what it was, what it
// became, and why. Append-only; never updated.
model ValueRestatement {
  id           String     @id @default(cuid())
  initiative   Initiative @relation(fields: [initiativeId], references: [id], onDelete: Cascade)
  initiativeId String

  previousValueInr Float
  newValueInr      Float
  previousTcoInr   Float?
  newTcoInr        Float?

  reason         String
  restatedBy     String
  restatedByRole String
  restatedAt     DateTime @default(now())

  @@index([initiativeId])
}

model MonthlyReport {
  id          String   @id @default(cuid())
  month       Int // 1..12
  year        Int
  payload     Json // aggregated snapshot (completed/delayed/missed)
  narrative   String? // AI-generated narrative (nullable until generated)
  generatedAt DateTime @default(now())

  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])

  // Scoped per organization: two client workspaces must be able to publish
  // the same period independently.
  @@unique([organizationId, year, month])
}

// ---------- Value Realization Layer ----------

// A single quantified benefit claimed by an initiative or a demand.
// One initiative/demand can carry several (multi-benefit). RAG/value totals
// are computed at render; the ₹ figure (estimatedAnnualValueInr) is what rolls
// up into board dashboards once the parent initiative's value is signed off.
model BenefitClaim {
  id           String      @id @default(cuid())
  initiative   Initiative? @relation(fields: [initiativeId], references: [id], onDelete: Cascade)
  initiativeId String?
  demand       Demand?     @relation(fields: [demandId], references: [id], onDelete: Cascade)
  demandId     String?

  category                 BenefitCategory
  metricName               String // e.g. "UPI transaction drop rate"
  baselineValue            Float?
  targetValue              Float?

  // PROVENANCE — where each figure came from. Optional because existing claims
  // predate this, but a claim without a source is an assertion, not evidence:
  // the UI marks it as unsourced rather than letting it pass silently.
  // "Which report, which system, which extract, which date."
  baselineSource String?
  targetSource   String?
  unit                     BenefitUnit     @default(INR)
  estimatedAnnualValueInr  Float           @default(0) // ₹ value for board rollups
  confidence               Confidence      @default(MEDIUM)
  realizationHorizonMonths Int             @default(12)
  narrative                String          @default("")

  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  measurements ValueMeasurement[]

  @@index([initiativeId])
  @@index([demandId])
}

// A point-in-time reading of realized value for a benefit claim (+3/+6/+12mo).
model ValueMeasurement {
  id             String       @id @default(cuid())
  benefitClaim   BenefitClaim @relation(fields: [benefitClaimId], references: [id], onDelete: Cascade)
  benefitClaimId String
  measuredAt     DateTime     @default(now())
  horizonLabel   String // "+3m", "+6m", "+12m"
  actualValue    Float?
  realizedInr    Float?
  note           String       @default("")
  // Where this reading came from — a system, report or extract, not just a
  // free-text note. A realized ₹ figure typed by a human with no source is the
  // weakest link in the whole value chain.
  evidenceSource String?
  recordedByName String?

  @@index([benefitClaimId])
}

// Bank strategic metric / OKR catalog. Initiatives map to one or more.
model Okr {
  id              String           @id @default(cuid())
  name            String
  description     String           @default("")
  category        BenefitCategory?
  owner           String           @default("")
  targetStatement String           @default("")
  active          Boolean          @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])

  links InitiativeOkr[]
}

model InitiativeOkr {
  id               String     @id @default(cuid())
  initiative       Initiative @relation(fields: [initiativeId], references: [id], onDelete: Cascade)
  initiativeId     String
  okr              Okr        @relation(fields: [okrId], references: [id], onDelete: Cascade)
  okrId            String
  contributionNote String     @default("")

  @@unique([initiativeId, okrId])
  @@index([initiativeId])
  @@index([okrId])
}

// Demand-management funnel: business raises a need with quantified benefit(s),
// PMO triages, and on approval it converts into an Initiative.
model Demand {
  id               String         @id @default(cuid())
  title            String
  requirement      String
  raisedBy         User?          @relation("RaisedDemands", fields: [raisedById], references: [id])
  raisedById       String?
  raisedByName     String
  verticalHeadName String?
  status           DemandStatus   @default(RAISED)
  priority         DemandPriority @default(MEDIUM)
  reviewNote       String         @default("")

  // Indicative cost at intake. Captured here so a demand can be assessed on
  // value-vs-cost before it is ever funded — the ROI gate in M2 runs at this
  // point, not after the initiative exists. Carried onto the Initiative on
  // conversion. Same tiered shape as Initiative; same rule — never synthesised.
  estimatedCostInr Float?
  buildCostInr     Float?
  annualRunCostInr Float?
  tcoHorizonYears  Int?

  // Carried onto the Initiative on approval, so the funding rationale set at
  // intake survives conversion.
  investmentCategory InvestmentCategory @default(VALUE_GENERATING)

  convertedInitiative   Initiative? @relation("DemandInitiative", fields: [convertedInitiativeId], references: [id])
  convertedInitiativeId String?     @unique

  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  benefitClaims BenefitClaim[]

  @@index([status])
}

// ---------- Cross-system dependencies ----------
// "dependent depends on blocker" (i.e. blocker blocks dependent). Optional
// systemLabel names the shared system/interface (e.g. "CBS Loans API").
model Dependency {
  id          String     @id @default(cuid())
  dependent   Initiative @relation("Dependent", fields: [dependentId], references: [id], onDelete: Cascade)
  dependentId String
  blocker     Initiative @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blockerId   String
  systemLabel String?
  note        String     @default("")
  createdAt   DateTime   @default(now())

  @@unique([dependentId, blockerId])
  @@index([dependentId])
  @@index([blockerId])
}
